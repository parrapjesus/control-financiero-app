# ==============================================================================
# VARIABLES DE ENTORNO PARA CONTROL FINANCIERO PRO
# ==============================================================================
# En Vercel: Configura estas variables en Project Settings -> Environment Variables.
# Para desarrollo local: Copia este archivo a .env.local

# 1. Supabase (Obtén estos datos en tu proyecto Supabase -> Project Settings -> API)
SUPABASE_URL=https://tu-proyecto.supabase.co
SUPABASE_ANON_KEY=tu-clave-anon-publica

# 2. Google Gemini AI (Obtén tu API key gratuita en https://aistudio.google.com/)
GEMINI_API_KEY=tu-gemini-api-key
